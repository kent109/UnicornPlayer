                android:pathData="M196.00,130.00 L200.00,130.00 M194.00,133.46 L196.00,136.93 M190.00,133.46 L188.00,136.93 M188.00,130.00 L184.00,130.00 M190.00,126.54 L188.00,123.07 M194.00,126.54 L196.00,123.07"
