            </group>

            <!-- 底部走带机构 -->
            <!-- 左转轮（同心圆 + 6 根均分辐条） -->
            <path
                android:fillColor="#00000000"
                android:pathData="M40,130 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z"
                android:strokeWidth="1.5"
                android:strokeColor="#EDEFF3" />
            <path
                android:fillColor="#00000000"
                android:pathData="M44,130 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z"
                android:strokeWidth="1.5"
