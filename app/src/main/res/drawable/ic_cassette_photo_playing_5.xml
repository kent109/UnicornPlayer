                    android:fillColor="#15171F"
                    android:pathData="M158.00,39.00 C175.67,39.00 190.00,53.33 190.00,71.00 C190.00,88.67 175.67,103.00 158.00,103.00 C140.33,103.00 126.00,88.67 126.00,71.00 C126.00,53.33 140.33,39.00 158.00,39.00 Z" />
