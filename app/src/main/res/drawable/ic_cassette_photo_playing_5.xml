            <path
                android:fillColor="#15171F"
                android:pathData="M92,132.5 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
            <path
                android:fillColor="#15171F"
                android:pathData="M140,132.5 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
