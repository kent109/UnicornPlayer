<?xml version="1.0" encoding="utf-8"?><!-- 封面占位图的音符：视口 100x100，translateX/Y 把音符中心挪到画布正中，
     因此图标大小只需调 scaleX/scaleY；路径纵向只占 24 外框的 5→21，所以可见高度 ≈ scale × 16%
     （当前 4.4 ≈ 70%，约 6.2 才贴边），代码无需改动。
     translate 不受 scale 影响，1 单位 = 画布的 1%（渲染成 400px 封面时约 4px），
     translateY 40 = 比正中低 2 单位 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:tint="@color/art_placeholder_icon"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="4.4"
        android:scaleY="4.4"
        android:translateX="38"
        android:translateY="40">
        <path
            android:fillColor="@android:color/white"
            android:pathData="M12,5v7.55c-0.44,-0.26 -0.95,-0.42 -1.5,-0.42 -1.66,0 -3,1.34 -3,3s1.34,3 3,3 3,-1.34 3,-3V8.5h3V5h-4.5z" />
    </group>
</vector>
