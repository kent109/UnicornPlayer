                android:pathData="M62,71 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 Z" />
            <!-- 4.白色圆环(已删除,被放大的中心黑圆覆盖) -->
            <!-- 5.最里面黑色圆(r=13) -->
            <path
                android:fillColor="#15171F"
                android:pathData="M69,71 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 Z" />
