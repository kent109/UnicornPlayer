        <!-- 右卷轴（五层同心环 + 中心黑圆 + 圆周六白辐条，放大，旋转） -->
        <group
            android:name="reel_right"
            android:pivotX="158"
            android:pivotY="71">
            <!-- 1.最外黑色圆环 -->
            <path
                android:fillColor="#15171F"
                android:pathData="M122,71 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0 Z" />
