            android:pathData="M52.00,130.00 L56.00,130.00 M50.00,133.46 L52.00,136.93 M46.00,133.46 L44.00,136.93 M44.00,130.00 L40.00,130.00 M46.00,126.54 L44.00,123.07 M50.00,126.54 L52.00,123.07"
