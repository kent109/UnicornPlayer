        <!-- 窗口（米色；无圆角，顶部两角斜切：与水平夹角30°、与垂直夹角60°，水平边10/垂直边5.77，底部两角直角；左右各加宽3: x=32~208） -->
        <path
            android:fillColor="@color/disc_playing_color_1"
            android:pathData="M42,31 H198 L208,36.77 V111 H32 V36.77 Z" />

        <!-- 两根黑线：底端平齐灰色背景底边(y=111)并向外偏移5，顶端沿原方向延长贴在卷轴最外层黑环上，平头线帽 -->
