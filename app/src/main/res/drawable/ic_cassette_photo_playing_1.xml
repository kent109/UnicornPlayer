            <path
                android:fillColor="#15171F"
                android:pathData="M145,71 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 Z" />
            <!-- 6.圆周上六根辐条(暗灰色,指向圆心) -->
            <path
                android:fillColor="#00000000"
                android:strokeWidth="3.2"
                android:pathData="M171.000,71.000 L167.750,71.000 M164.500,82.258 L162.875,79.444 M151.500,82.258 L153.125,79.444 M145.000,71.000 L148.250,71.000 M151.500,59.742 L153.125,62.556 M164.500,59.742 L162.875,62.556"
