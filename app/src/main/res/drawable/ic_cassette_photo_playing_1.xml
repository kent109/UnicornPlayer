        <!-- 右转轮（同心圆 + 6 根均分辐条） -->
        <path
            android:fillColor="#00000000"
            android:pathData="M184,130 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z"
            android:strokeWidth="1.5"
            android:strokeColor="#BFC4CC" />
        <path
            android:fillColor="#00000000"
            android:pathData="M188,130 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z"
            android:strokeWidth="1.5"
            android:strokeColor="#BFC4CC" />
        <path
            android:fillColor="#00000000"
            android:strokeWidth="1.5"
            android:pathData="M196.00,130.00 L200.00,130.00 M194.00,133.46 L196.00,136.93 M190.00,133.46 L188.00,136.93 M188.00,130.00 L184.00,130.00 M190.00,126.54 L188.00,123.07 M194.00,126.54 L196.00,123.07"
            android:strokeColor="#BFC4CC" />
        <path
            android:fillColor="#15171F"
            android:pathData="M190.2,130 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0 Z" />
        <!-- 底部中央凹槽（磁头/压带毛毡位，已加回：此前误删） -->
        <path
            android:fillColor="#15171F"
            android:pathData="M108,130 L132,130 L134,144 L106,144 Z"
            android:strokeWidth="1"
            android:strokeColor="#3A3D47" />
        <!-- 压带毛毡垫 -->
        <path
            android:fillColor="#B5654A"
            android:pathData="M114,136 H126 V141 H114 Z" />
        <path
            android:fillColor="#00000000"
            android:strokeWidth="1"
            android:pathData="M120,136 V141"
            android:strokeColor="#7A4636" />
