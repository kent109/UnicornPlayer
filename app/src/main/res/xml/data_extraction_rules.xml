<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude database files from cloud backup -->
        <exclude domain="file" path="music_database" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude database files from device transfer -->
        <exclude domain="file" path="music_database" />
    </device-transfer>
</data-extraction-rules>