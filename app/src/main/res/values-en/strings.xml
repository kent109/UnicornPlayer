    <string name="permission_scene_label">Usage:</string>
    <string name="permission_list_intro">Permissions requested by UnicornPlayer and their usage</string>

    <!-- Permission descriptions + scenes -->
    <string name="perm_desc_internet">Allows the app to access the internet for checking updates and syncing data.</string>
    <string name="perm_scene_internet">Checking app updates, network requests</string>

    <string name="perm_desc_read_media_audio">Allows the app to read audio files on your device for scanning and playing local music.</string>
    <string name="perm_scene_read_media_audio">Scanning local music library, playing audio files</string>
    <string name="perm_desc_read_external_storage">Allows the app to read files in external storage for scanning music on older Android versions.</string>
    <string name="perm_scene_read_external_storage">Scanning local music library, playing audio files on Android 12 and below</string>

    <string name="perm_desc_wake_lock">Allows the app to keep the device partially awake while playing music to avoid playback interruption.</string>
    <string name="perm_scene_wake_lock">Preventing system sleep during background playback</string>

    <string name="perm_desc_fg_service">Allows the app to run a foreground service to ensure music playback continues in the background.</string>
    <string name="perm_scene_fg_service">Continuous background music playback</string>

    <string name="perm_desc_fg_media">Allows the app to use a media playback foreground service type, required for background music on Android 14+.</string>
    <string name="perm_scene_fg_media">Android 14+ background media playback</string>

    <string name="perm_desc_post_notifications">Allows the app to send notifications for the currently playing song and playback controls.</string>
    <string name="perm_scene_post_notifications">Notification playback controller</string>

    <string name="perm_desc_bluetooth">Allows the app to access Bluetooth adapter to monitor Bluetooth A2DP device connect/disconnect events.</string>
    <string name="perm_scene_bluetooth">Monitoring Bluetooth state changes</string>

    <string name="perm_desc_bluetooth_admin">Allows the app to manage Bluetooth connection state and handle playback pause on Bluetooth disconnect.</string>
    <string name="perm_scene_bluetooth_admin">Handling Bluetooth disconnect events, auto-pause playback</string>

    <string name="perm_desc_bluetooth_connect">Allows the app to connect to paired Bluetooth devices and get connection state.</string>
    <string name="perm_scene_bluetooth_connect">Getting Bluetooth device connection state</string>

    <string name="perm_desc_install_packages">Allows the app to request installing APK files from unknown sources, used only when updating the app from within.</string>
    <string name="perm_scene_install_packages">Installing updates downloaded from within the app</string>
</resources>
