    <!-- Privacy dialog -->
    <string name="privacy_dialog_title">Hi, Welcome to UnicornPlayer</string>
    <string name="privacy_dialog_content_full">We take your personal information privacy seriously and handle your usage data in strict accordance with relevant laws and regulations.\n\nPlease read the Privacy Policy carefully to understand the types of information we collect, how we use it, and your rights.\n\nWe only collect the minimum information necessary to implement core features and will never collect your private content beyond scope.</string>
