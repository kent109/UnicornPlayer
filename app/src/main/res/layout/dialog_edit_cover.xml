<?xml version="1.0" encoding="utf-8"?>
<!-- 修改封面弹窗的面板：PanelDialog 的窗口是透明的，标题/说明/按钮都在这个布局里自己画，
     宽度由外壳决定（屏宽减去左右各 @dimen/dialog_panel_side_margin），不再由内容撑开 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/modify_cover"
        android:textColor="@color/onSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/cover_save_note"
        android:textColor="@color/onSurfaceVariant"
        android:textSize="14sp" />

    <!-- 预览图与播放页封面同一套处理：恒垫灰底（浅色封面/占位音符在弹窗底色上轮廓不清）+ CenterCrop 铺满 -->
    <ImageView
        android:id="@+id/ivCoverPreview"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_cover_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        tools:src="@drawable/ic_music_note" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.UnicornPlayer.Button.TextButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDefaultCover"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/default_cover"
            android:textColor="@color/danger_text"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickCover"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/select_cover" />

    </LinearLayout>

</LinearLayout>
