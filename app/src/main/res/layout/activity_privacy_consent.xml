<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 应用图标 + 标题（整体居中） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 应用图标：圆角 primary 背景 + 白色音符 -->
        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_privacy_icon"
            android:contentDescription="@string/app_name"
            android:padding="6dp"
            android:src="@drawable/ic_music_large"
            app:tint="@android:color/white" />

        <!-- 标题 -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/privacy_dialog_title"
            android:textColor="@color/onSurface"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 正文（带超链接，可滚动） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tvDialogContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="8dp"
            android:textColor="@color/onSurface"
            android:textSize="15sp" />

    </ScrollView>

    <!-- 复选框（仅自身区域可点击，右边空白不响应） -->
    <CheckBox
        android:id="@+id/cbAgree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/privacy_dialog_agree_checkbox"
        android:textColor="@color/error"
        android:textSize="14sp" />

    <!-- 按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnReject"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="?attr/colorSurfaceVariant"
            android:text="@string/privacy_dialog_reject"
            android:textAllCaps="false"
            android:textColor="@color/onSurface" />

        <Button
            android:id="@+id/btnAgree"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/privacy_dialog_agree"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
