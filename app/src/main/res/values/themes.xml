<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.UnicornPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorPrimaryContainer">@color/primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/onPrimaryContainer</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorSecondaryContainer">@color/secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/onSecondaryContainer</item>

        <!-- Tertiary brand color -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/onTertiary</item>
        <item name="colorTertiaryContainer">@color/tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/onTertiaryContainer</item>

        <!-- Error colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/onError</item>
        <item name="colorErrorContainer">@color/errorContainer</item>
        <item name="colorOnErrorContainer">@color/onErrorContainer</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/onBackground</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>
        <item name="dialogPanelColor">@color/dialog_panel_color_default</item>
        <item name="dialogItemColor">@color/dialog_item_color_default</item>

        <!-- Outline colors -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>

        <!-- Status bar color - 透明实现沉浸式 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>

        <!-- Navigation bar color - 透明实现沉浸式 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>

        <!-- Enable edge-to-edge -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:fitsSystemWindows">false</item>

        <!-- 添加主题属性来判断是否是亮色主题 -->
        <item name="isLightTheme">true</item>

        <!-- AlertDialog 否定性按钮颜色 -->
        <item name="materialButtonOutlinedStyle">@style/Widget.UnicornPlayer.Button.TextButton.Secondary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.UnicornPlayer.Button.TextButton.Secondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.UnicornPlayer.Button.TextButton.Secondary</item>
        <!-- AlertDialog 窗口底色统一使用弹窗面板底色 -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Unicorn.Dialog.Alert</item>

        <!-- ProgressBar 使用主题色 -->
        <item name="android:progressBarStyle">@style/Widget.UnicornPlayer.ProgressBar</item>
    </style>

    <style name="Widget.UnicornPlayer.ProgressBar" parent="@android:style/Widget.Material.ProgressBar">
        <item name="android:indeterminateTint">?attr/colorPrimary</item>
    </style>

    <style name="searchStyle">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 否定性按钮样式（取消、放弃等） -->
    <style name="Widget.UnicornPlayer.Button.TextButton.Secondary" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/secondary</item>
    </style>

    <!-- 主题色1: 红（色值取 disc_playing_color_1） -->
    <style name="Theme.UnicornPlayer.Color1" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">@color/disc_playing_color_1</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#ED6E98</item>
        <item name="dialogPanelColor">@color/dialog_panel_color_1</item>
        <item name="dialogItemColor">@color/dialog_item_color_1</item>
        <item name="colorOnPrimaryContainer">#4a004a</item>
    </style>

    <!-- 主题色2: 橙（色值取 disc_playing_color_2） -->
    <style name="Theme.UnicornPlayer.Color2" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">@color/disc_playing_color_2</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#F8B14C</item>
        <item name="dialogPanelColor">@color/dialog_panel_color_2</item>
        <item name="dialogItemColor">@color/dialog_item_color_2</item>
        <item name="colorOnPrimaryContainer">#5a0030</item>
    </style>

    <!-- 主题色3: 黄（色值取 disc_playing_color_3） -->
    <style name="Theme.UnicornPlayer.Color3" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">@color/disc_playing_color_3</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#F6E661</item>
        <item name="dialogPanelColor">@color/dialog_panel_color_3</item>
        <item name="dialogItemColor">@color/dialog_item_color_3</item>
        <item name="colorOnPrimaryContainer">#5a4a0f</item>
    </style>

    <!-- 主题色4: 绿（色值取 disc_playing_color_4） -->
    <style name="Theme.UnicornPlayer.Color4" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">@color/disc_playing_color_4</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#93F483</item>
        <item name="dialogPanelColor">@color/dialog_panel_color_4</item>
        <item name="dialogItemColor">@color/dialog_item_color_4</item>
        <item name="colorOnPrimaryContainer">#1a4a2a</item>
    </style>

    <!-- 主题色5: 青（色值取 disc_playing_color_5） -->
    <style name="Theme.UnicornPlayer.Color5" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">@color/disc_playing_color_5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#A6F2F6</item>
        <item name="dialogPanelColor">@color/dialog_panel_color_5</item>
        <item name="dialogItemColor">@color/dialog_item_color_5</item>
        <item name="colorOnPrimaryContainer">#0f2d5a</item>
    </style>

    <!-- 主题色6: 蓝（色值取 disc_playing_color_6） -->
    <style name="Theme.UnicornPlayer.Color6" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">@color/disc_playing_color_6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#5B78ED</item>
        <item name="dialogPanelColor">@color/dialog_panel_color_6</item>
        <item name="dialogItemColor">@color/dialog_item_color_6</item>
        <item name="colorOnPrimaryContainer">#0f5a5a</item>
    </style>

    <!-- 主题色7: 紫（色值取 disc_playing_color_7） -->
    <style name="Theme.UnicornPlayer.Color7" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">@color/disc_playing_color_7</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E37CF4</item>
        <item name="dialogPanelColor">@color/dialog_panel_color_7</item>
        <item name="dialogItemColor">@color/dialog_item_color_7</item>
        <item name="colorOnPrimaryContainer">#2d0f5a</item>
    </style>
</resources>