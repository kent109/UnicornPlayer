<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.UnicornPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorPrimaryContainer">@color/primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/onPrimaryContainer</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorSecondaryContainer">@color/secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/onSecondaryContainer</item>

        <!-- Tertiary brand color -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/onTertiary</item>
        <item name="colorTertiaryContainer">@color/tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/onTertiaryContainer</item>

        <!-- Error colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/onError</item>
        <item name="colorErrorContainer">@color/errorContainer</item>
        <item name="colorOnErrorContainer">@color/onErrorContainer</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/onBackground</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>

        <!-- Outline colors -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>

        <!-- Status bar color - 透明实现沉浸式 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>

        <!-- Navigation bar color - 透明实现沉浸式 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>

        <!-- Enable edge-to-edge -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:fitsSystemWindows">false</item>

        <!-- 添加主题属性来判断是否是亮色主题 -->
        <item name="isLightTheme">true</item>
    </style>

    <style name="searchStyle">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 主题色1: 品红 #f800f8 -->
    <style name="Theme.UnicornPlayer.Color1" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">#f800f8</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#fce4fc</item>
        <item name="colorOnPrimaryContainer">#4a004a</item>
    </style>

    <!-- 主题色2: 亮粉 #f00078 -->
    <style name="Theme.UnicornPlayer.Color2" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">#f00078</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#fde4ef</item>
        <item name="colorOnPrimaryContainer">#5a0030</item>
    </style>

    <!-- 主题色3: 黄色 #f3c832 -->
    <style name="Theme.UnicornPlayer.Color3" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">#f3c832</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#fdf5d6</item>
        <item name="colorOnPrimaryContainer">#5a4a0f</item>
    </style>

    <!-- 主题色4: 绿色 #4ab069 -->
    <style name="Theme.UnicornPlayer.Color4" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">#4ab069</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#d9f2e3</item>
        <item name="colorOnPrimaryContainer">#1a4a2a</item>
    </style>

    <!-- 主题色5: 蓝色 #377eea -->
    <style name="Theme.UnicornPlayer.Color5" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">#377eea</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#d9e8fc</item>
        <item name="colorOnPrimaryContainer">#0f2d5a</item>
    </style>

    <!-- 主题色6: 青色 #26fdfd -->
    <style name="Theme.UnicornPlayer.Color6" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">#26fdfd</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#d6fdfd</item>
        <item name="colorOnPrimaryContainer">#0f5a5a</item>
    </style>

    <!-- 主题色7: 紫色 #7e3ae4 -->
    <style name="Theme.UnicornPlayer.Color7" parent="Theme.UnicornPlayer">
        <item name="colorPrimary">#7e3ae4</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#e8d9fc</item>
        <item name="colorOnPrimaryContainer">#2d0f5a</item>
    </style>
</resources>