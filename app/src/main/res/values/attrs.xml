<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="TitleBar">
        <!-- 标题文字 -->
        <attr name="title" format="string" />
        <!-- 中间区域布局 -->
        <attr name="midView" format="reference" />
        <!-- 右侧区域布局 -->
        <attr name="rightView" format="reference" />
        <!-- 返回按钮是否显示 -->
        <attr name="backButtonVisible" format="boolean" />
    </declare-styleable>

    <declare-styleable name="AudioQualityLabel">
        <!-- 显示的文字 -->
        <attr name="aq_text" format="string" />
        <!-- 边框和文字颜色 -->
        <attr name="aq_color" format="color" />
    </declare-styleable>
</resources>
