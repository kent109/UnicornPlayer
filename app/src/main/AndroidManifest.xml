<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 权限声明 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 蓝牙权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 安装未知应用权限（检查更新功能需要） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />

    <application
        android:name=".UnicornPlayerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnicornPlayer"
        tools:targetApi="31">

        <profileable android:shell="true" />

        <!-- MainActivity（LAUNCHER 入口，冷启动时在最开头检查隐私协议标记） -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.PlayerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.EqualizerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.DocViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.PermissionListActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.ManualActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.FeedbackActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.LyricsOptionsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.ThemeSettingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.ThemeColorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.HighlightColorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.IconSettingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.ScanFilterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.DirectoryPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.GenreSelectActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.LanguageChooseActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.LrcSearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.ArtistSongsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.AlbumSongsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".activity.PlaylistSongsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UnicornPlayer"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <service
            android:name=".service.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="com.unicorn.player.action.PLAY" />
                <action android:name="com.unicorn.player.action.PAUSE" />
                <action android:name="com.unicorn.player.action.NEXT" />
                <action android:name="com.unicorn.player.action.PREVIOUS" />
                <action android:name="com.unicorn.player.action.STOP" />
            </intent-filter>
        </service>

        <activity
            android:name=".activity.ShortcutBridgeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="com.unicorn.player.action.TOGGLE_EQUALIZER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>