<?xml version="1.0" encoding="utf-8"?>
<!-- 预设下拉列表的行间分割线：左右各缩进 16dp，厚度由 ListView.setDividerHeight 决定（0.8dp），
     样式与 app 模块歌曲排序弹层的分隔线一致 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/eq_divider_color" />
        </shape>
    </item>
</layer-list>
